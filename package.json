{
  "name": "jp-signal-3d",
  "version": "1.0.0",
  "description": "日本の信号機・軌道の3Dモデル(Three.js で作図 → GLB 書き出し)とビューア",
  "scripts": {
    "registry": "node 3d/tools/gen-registry.cjs",
    "export": "node 3d/tools/export.cjs",
    "optimize": "node 3d/tools/optimize.cjs",
    "thumbs": "node 3d/tools/thumbs.cjs",
    "check": "node 3d/tools/check.cjs && node 3d/tools/check-deps.cjs && node 3d/tools/check-gltf.cjs",
    "viewer": "node 3d/tools/build-viewer.cjs",
    "pack": "B64=1 node 3d/tools/build-viewer.cjs && node 3d/tools/pack-artifact.cjs",
    "build": "npm run export && npm run optimize && npm run check && npm run viewer && npm run smoke",
    "audit": "node 3d/tools/audit.cjs",
    "smoke": "node 3d/tools/smoke.cjs",
    "assets": "node 3d/tools/fetch-assets.cjs",
    "lint": "eslint .",
    "validate": "node 3d/tools/check-gltf.cjs",
    "quality": "node 3d/tools/quality.cjs",
    "check:ao": "node 3d/tools/check-ao.cjs",
    "audit:mobile": "node 3d/tools/audit-mobile.cjs",
    "check:ao-all": "node 3d/tools/check-ao-all.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mai-ima/3D-01.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "n8ao": "^2.1.0",
    "postprocessing": "^6.39.6",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0"
  },
  "private": true
}